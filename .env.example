# .env.example

# VAPI Configuration
VAPI_KEY=your_vapi_key_here

# Gemini Configuration
GEMINI_KEY=your_gemini_key_here

# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Calendar Configuration
GOOGLE_CALENDAR_ID=your_google_calendar_id_here
GOOGLE_CALENDAR_SECRET=your_google_calendar_secret_here

# Make.com Configuration
MAKE_COM_API_KEY=your_make.com_api_key_here

# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Database Configuration
DB_HOST=your_database_host_here
DB_PORT=your_database_port_here
DB_USER=your_database_user_here
DB_PASS=your_database_password_here
DB_NAME=your_database_name_here